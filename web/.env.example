# Copy to .env.local for local overrides, or set these in Vercel →
# Project → Settings → Environment Variables.

# Where every "Open the app / Analyse my skin / Sign in" button points.
# Defaults to the Hugging Face Space if unset.
NEXT_PUBLIC_APP_URL=https://elisha622-skinsense.hf.space

# Public URL of this marketing site, used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt. Optional on Vercel (falls back to the project's
# production domain). Set it once you add a custom domain.
NEXT_PUBLIC_SITE_URL=
